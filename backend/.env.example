APP_ENV=development
PORT=8080
DATABASE_URL=postgres://eventhub:eventhub@localhost:5432/eventhub?sslmode=disable
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# CLOUDINARY_URL=  (later: poster uploads)
HOLD_MINUTES=5
FRONTEND_ORIGIN=http://localhost:5173
HOLD_RATE_PER_MIN=20

# Admins (comma-separated emails) get the /admin page
ADMIN_EMAILS=admin@eventhub.dev

# Email (future extension, off by default: tickets are downloaded from the site).
# To turn on: BREVO_API_KEY + MAIL_FROM (production), or SMTP_* (e.g. local Mailpit:
# `docker compose --profile email up -d mailpit`, SMTP_HOST=localhost, SMTP_PORT=1025).
MAIL_FROM=EventHub <tickets@eventhub.local>
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
