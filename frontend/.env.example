# Google OAuth Web client ID (same value as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# Keep /api: the dev server and Vercel both proxy it to the Go API (same-origin cookies)
VITE_API_BASE=/api
# Production only, optional: open the live seat stream directly on the API host,
# e.g. https://eventhub-api.onrender.com/api
VITE_STREAM_BASE=
